# Chainseabase environment variables — names only, never commit real values.
# Loaded by scripts/config/load-config.mjs for the website, CLI scripts and scheduled tasks:
#   CHAINSEABASE_CONFIG_FILE=<absolute path> (a protected KEY=VALUE file outside the repository;
#   required for APP_ENV=staging|production), else .env.local in development. Conflicting
#   sources are refused (exit 78, names only). Windows: docs/windows-setup.md.
# Never use NEXT_PUBLIC_ for secrets.

# --- Database (native Windows; legacy Supabase supported separately) ---
# Runtime connection. Native Windows (same-host PostgreSQL): no password in the URL, password in
# PGPASSWORD (a password in the URL that differs from PGPASSWORD is refused). Legacy Supabase:
# paste as given, keeping its parameters, with sslmode=verify-full. Required with
# APP_ENV=staging|production (no local fallback). Local default:
DATABASE_URL=postgresql://chainseabase_dev@127.0.0.1:5432/chainseabase_dev
# Secret: used when the URL has no password. Never log its value.
PGPASSWORD=
# Direct connection used only by `npm run db:migrate` (optional; falls back to DATABASE_URL)
DIRECT_DATABASE_URL=

# --- Site origins (host allowlist; one app, two hosts) ---
# Staging/production: both required, https, two different hosts, origin only (no path).
ADMIN_ORIGIN=http://localhost:3000
PORTAL_ORIGIN=http://127.0.0.1:3000

# --- Sessions and token encryption (secrets) ---
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# Older keys kept for decryption after rotation: "1:<base64>,2:<base64>"
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# --- Google OAuth (login + per-user Calendar authorization) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- First team member (consumed once by `npm run db:bootstrap` + first login) ---
BOOTSTRAP_TEAM_EMAIL=

# --- Resend (invitation email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Avatar storage (STORAGE_PROVIDER below: filesystem | supabase | fake) ---
# Native Windows: STORAGE_PROVIDER=filesystem with a fixed absolute directory OUTSIDE the app
# directory (upgrades never touch it), e.g. C:\ProgramData\Chainseabase\data\avatars, created
# and protected by scripts/windows/Initialize-ChainseabaseAvatarStorage.ps1. Files are served only
# through /api/v1/avatars. Unset STORAGE_PROVIDER + this set means filesystem.
AVATAR_STORAGE_DIR=
# Legacy Supabase Storage adapter (bucket stays private, server-side only); STORAGE_PROVIDER=supabase
# ("real" is the legacy name). Never set STORAGE_PROVIDER=fake to bypass production guards.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# --- Scheduled job runner (Vercel Cron sends "Authorization: Bearer $CRON_SECRET") ---
# On Vercel set CRON_SECRET only. JOB_RUNNER_SECRET (local/other schedulers) wins if both are set.
CRON_SECRET=
JOB_RUNNER_SECRET=

# --- Provider modes: real | fake (storage: filesystem | supabase | fake, see above). Default is
# real when credentials exist, otherwise fake.
# APP_ENV=staging|production (or VERCEL_ENV=production) refuses fake providers and the test
# login, and fails at startup when a real provider's variables are missing (names only).
CALENDAR_PROVIDER=
EMAIL_PROVIDER=
STORAGE_PROVIDER=
APP_ENV=

# --- Development / E2E only: enables POST /api/v1/test-support/login (never in production)
E2E_TEST_LOGIN=
