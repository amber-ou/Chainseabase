{
  "name": "chainseabase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --import ./scripts/config/preload.mjs ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "node --import ./scripts/config/preload.mjs ./node_modules/next/dist/bin/next start --hostname 127.0.0.1 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:seed-dev": "tsx scripts/seed-dev.ts",
    "jobs:run": "tsx scripts/run-jobs.ts",
    "config:check": "tsx scripts/config-check.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run security:scan",
    "security:scan": "tsx scripts/check-secrets.ts",
    "db:restore-drill": "tsx scripts/restore-drill.ts",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "5.3.1",
    "geist": "1.8.2",
    "jose": "6.2.13",
    "luxon": "3.7.2",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
